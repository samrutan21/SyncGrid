# Dependencies
node_modules/

# Build and caches
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.cache/
.turbo/
.eslintcache

# Logs and coverage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# Environment and secrets.
# Real keys belong in .env.local (or another .env.* file), never in source.
# .env.example is the only env file that is safe to commit.
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
*.cer
id_rsa
id_ed25519
credentials.json
credentials*.json
*service-account*.json
*serviceAccount*.json
secrets/
.secrets/
*.secret

# npm tokens, if a user-level or project npmrc ever gets one
.npmrc

# Editors and OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.cursor/

# Local media. The app keeps footage in the browser, not in the repo.
*.mov
*.mp4
*.mxf
*.m4v
*.wav
*.aif
*.aiff

# Episode exports stay on this machine. public/sample-data is the local demo.
public/sample-data/
*.xml
*.edl
*.srt
*.vtt
*.fcpxml

# The public demo is the one place episode files may be committed.
!public/demo/
!public/demo/**

# Local project profiles. Private work files; never commit or push.
/profiles/
